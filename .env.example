# --- infra (Zerops injects these automatically in production) ---
DATABASE_URL=postgresql+psycopg://zeroth:zeroth@localhost:5432/zeroth
VALKEY_URL=redis://localhost:6379/0

# --- LLM ---
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant

# --- Zerops (fill after the spike) ---
ZCLI_TOKEN=
PATHFINDER_PROVIDER=simulated   # simulated | zcli
ZEROTH_PUBLIC_URL=http://localhost:8000

# --- limits ---
MAX_REPO_MB=50
MAX_ATTEMPTS=3
PROVISION_TIMEOUT_S=180
DEPLOY_TIMEOUT_S=300
MAX_CONCURRENT_RUNS=2
RATE_LIMIT_PER_HOUR=10
