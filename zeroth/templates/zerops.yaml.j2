{#
  build.base must be a real runtime; "static" is only valid as run.base.
  Zerops' own zerops.yml docs use nodejs@latest to build a static site with
  no compile step. build.os has no working default in practice - confirmed
  against a real deploy where an omitted os was rejected as an empty string,
  despite docs claiming alpine is default.
#}
# Generated by Zeroth from {{ repo_url }}
zerops:
{% for svc in manifest.services %}
{% if svc.role in ('api', 'web', 'worker') %}
  - setup: {{ svc.hostname }}
    build:
      base: {{ 'nodejs@latest' if svc.type == 'static' else svc.type }}
      os: alpine
      buildCommands:
{% for cmd in svc.build_commands or ['echo "no build step detected"'] %}
        - {{ cmd }}
{% endfor %}
      deployFiles: ./
      cache:
{% if svc.type.startswith('python') %}
        - ~/.cache/pip
{% elif svc.type.startswith('nodejs') %}
        - node_modules
{% else %}
        - ./
{% endif %}
    run:
      base: {{ svc.type }}
{% if svc.public %}
      ports:
        - port: {{ svc.port or (8080 if svc.type == 'static' else 8000) }}
          httpSupport: true
{% endif %}
{% if svc.type != 'static' %}
      start: {{ svc.start_command }}
{% endif %}
{% endif %}
{% endfor %}
