{#
  The build and run shape comes from zeroth/worker/recipes.py, which vendors
  the published Zerops recipes. The model chooses WHAT to deploy; how a stack
  is built and started on this platform is not a judgement call, and deriving
  it per run is how the generator kept reinventing already-documented rules.

  Anything still decided here is decided from the manifest: whether a service
  is public, which port it uses, and the start command when the model supplied
  one (it read the repository; this template did not).
#}
# Generated by Zeroth from {{ repo_url }}
zerops:
{% for svc in manifest.services %}
{% if svc.role in ('api', 'web', 'worker') %}
{% set r = svc.recipe %}
  - setup: {{ svc.hostname }}
    build:
      base: {{ 'nodejs@latest' if svc.type == 'static' else svc.type }}
      os: {{ r.os }}
      buildCommands:
{% for cmd in svc.build_commands or r.build_commands or ['echo "no build step detected"'] %}
        - {{ cmd }}
{% endfor %}
      deployFiles: ./
{% if r.add_to_run_prepare %}
      addToRunPrepare:
{% for f in r.add_to_run_prepare %}
        - {{ f }}
{% endfor %}
{% endif %}
{% if r.cache %}
      cache:
{% for c in r.cache %}
        - {{ c }}
{% endfor %}
{% endif %}
{% if r.build_env %}
      envVariables:
{% for k, v in r.build_env.items() %}
        {{ k }}: {{ v }}
{% endfor %}
{% endif %}
    run:
      base: {{ svc.type }}
      os: {{ r.os }}
{% if svc.public %}
      ports:
        - port: {{ svc.port or r.default_port }}
          httpSupport: true
{% endif %}
{% if svc.type != 'static' %}
{% if r.prepare_commands %}
      prepareCommands:
{% for cmd in r.prepare_commands %}
        - {{ cmd }}
{% endfor %}
{% endif %}
{% if r.init_commands %}
      initCommands:
{% for cmd in r.init_commands %}
        - {{ cmd }}
{% endfor %}
{% endif %}
{% set run_env = dict(r.run_env, **(svc.env or {})) %}
{% if run_env %}
{# svc.env is what the REPAIR loop patches. Not rendering it meant every
   env repair the model proposed was silently discarded - the diff showed a
   fix and the redeploy shipped without it. #}
      envVariables:
{% for k, v in run_env.items() %}
        {{ k }}: {{ v }}
{% endfor %}
{% endif %}
      start: {{ svc.start_command or r.start }}
{% endif %}
{% endif %}
{% endfor %}
