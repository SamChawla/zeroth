# Generated by Zeroth from {{ repo_url }}
# Verified: {{ verified_note }}
#
# Reproduce with:
#   zcli project project-import zerops-project-import.yaml
project:
  name: {{ manifest.project_name }}
  tags:
    - zeroth
    - generated
services:
{#
  Databases and caches first: priority controls creation order, so runtimes
  do not come up before the services they connect to exist.
#}
{% for svc in manifest.services if svc.role in ('database', 'cache', 'storage') %}
  - hostname: {{ svc.hostname }}
    type: {{ svc.type }}
    mode: NON_HA
    priority: 1
{% endfor %}
{% for svc in manifest.services if svc.role not in ('database', 'cache', 'storage') %}
  - hostname: {{ svc.hostname }}
    type: {{ svc.type }}
{% if svc.public %}
    enableSubdomainAccess: true
{% endif %}
{% if svc.env %}
    envSecrets:
{% for key, value in svc.env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% endfor %}
